{
  "name": "@entailer/core",
  "version": "1.0.0",
  "description": "The deterministic verifier core for Entailer: Formula AST, IR, propositional tableau + DPLL, classification, and the LogicReport schema. Zero LLM/solver dependencies — the trusted kernel.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barmoshe/entailer.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/barmoshe/entailer#readme",
  "publishConfig": {
    "access": "public"
  }
}
