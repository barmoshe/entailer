              "kind": {
                "type": "string",
                "enum": [
                  "modal",
                  "deontic",
                  "temporal",
                  "probabilistic",
                  "causal",
                  "vague",
                  "higher-order",
                  "generalized-quantifier",
                  "ambiguous-reading"
