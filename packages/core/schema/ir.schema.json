{
  "$ref": "#/definitions/FormalizedArgument",
  "definitions": {
    "FormalizedArgument": {
      "type": "object",
      "properties": {
        "logic": {
          "type": "string",
          "enum": [
            "PROP",
            "FOL"
          ]
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "atom",
                  "pred",
                  "const",
                  "func"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "arity": {
                "type": "integer",
                "minimum": 0
              },
              "gloss": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "stated"
                  },
                  {
                    "type": "string",
                    "const": "supplied"
                  },
                  {
                    "type": "string",
                    "pattern": "^reading:.+"
                  }
                ]
              },
              "spans": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "uri": {
                      "type": "string"
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "kind",
              "name",
              "arity",
              "gloss",
              "source",
              "spans"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "premises": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ast": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "atom"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "pred"
                      },
                      "name": {
                        "type": "string"
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "var"
                                },
                                "name": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "type",
                                "name"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "type": "string",
                                  "const": "func"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "args": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast/anyOf/1/properties/args/items"
                                  }
                                }
                              },
                              "required": [
                                "type",
                                "name",
                                "args"
                              ],
                              "additionalProperties": false
                            }
                          ]
                        }
                      }
                    },
                    "required": [
                      "type",
                      "name",
                      "args"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "not"
                      },
                      "sub": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      }
                    },
                    "required": [
                      "type",
                      "sub"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "and"
                      },
                      "left": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      },
                      "right": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      }
                    },
                    "required": [
                      "type",
                      "left",
                      "right"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "or"
                      },
                      "left": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      },
                      "right": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      }
                    },
                    "required": [
                      "type",
                      "left",
                      "right"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "implies"
                      },
                      "left": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      },
                      "right": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      }
                    },
                    "required": [
                      "type",
                      "left",
                      "right"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "iff"
                      },
                      "left": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      },
                      "right": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      }
                    },
                    "required": [
                      "type",
                      "left",
                      "right"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "bottom"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "top"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "forall"
                      },
                      "variable": {
                        "type": "string"
                      },
                      "sub": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      }
                    },
                    "required": [
                      "type",
                      "variable",
                      "sub"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "exists"
                      },
                      "variable": {
                        "type": "string"
                      },
                      "sub": {
                        "$ref": "#/definitions/FormalizedArgument/properties/premises/items/properties/ast"
                      }
                    },
                    "required": [
                      "type",
                      "variable",
                      "sub"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "role": {
                "type": "string",
