            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "signals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "band",
            "score",
            "signals"
          ],
          "additionalProperties": false
        },
        "ambiguity": {
          "type": "object",
          "properties": {
            "readings": {
              "type": "array",
