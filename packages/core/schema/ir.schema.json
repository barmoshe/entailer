              },
              "spans": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/FormalizedArgument/properties/symbols/items/properties/spans/items"
                }
              }
            },
            "required": [
              "text",
              "kind",
              "spans"
            ],
            "additionalProperties": false
          },
          "default": []
