{
  "name": "@entailer/viz",
  "version": "1.1.0",
  "description": "Deterministic visualizers for Entailer: typed view-models + dependency-free text / SVG / Mermaid renderers. Colors a verdict only when its certificate (proof / counter-model) is present.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@entailer/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barmoshe/entailer.git",
    "directory": "packages/viz"
  },
  "homepage": "https://github.com/barmoshe/entailer#readme",
  "publishConfig": {
    "access": "public"
  }
}
