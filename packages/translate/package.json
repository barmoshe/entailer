{
  "name": "@entailer/translate",
  "version": "1.2.0",
  "description": "The Entailer LLM translator: prose -> typed IR via Claude structured outputs. The ONLY LLM-touching package; the deterministic core consumes its output.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@entailer/core": "workspace:*",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": ">=0.40"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barmoshe/entailer.git",
    "directory": "packages/translate"
  },
  "homepage": "https://github.com/barmoshe/entailer#readme",
  "publishConfig": {
    "access": "public"
  }
}
